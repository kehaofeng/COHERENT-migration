<?xml version="1.0"?>
<package format="3">
  <name>hademo_nodes</name>
  <version>0.1.0</version>
  <description>ROS 2 nodes for bridging COHERENT to Isaac Sim's Python 3.7 process.</description>
  <maintainer email="kehaofeng@todo.invalid">COHERENT migration maintainers</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>hademo</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
